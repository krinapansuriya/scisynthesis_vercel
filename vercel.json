{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/:path*",     "destination": "/api/index" },
    { "source": "/avatars/:path*", "destination": "/api/index" },
    { "source": "/(.*)",           "destination": "/index.html" }
  ]
}
