# ─────────────────────────────────────────────────────────────────────────────
# SciSynthesis — Environment Variables
# Copy this file to .env for local development.
# In Vercel, add these via Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Secret key used to sign JWT tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this

# Google Gemini API key (used for AI analysis, synthesis, and embeddings)
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key


# ── Optional — Database ───────────────────────────────────────────────────────

# By default the app uses SQLite.
# • Local dev:  ./research_assistant.db  (in the project directory)
# • On Vercel:  /tmp/research_assistant.db  (ephemeral — data resets per cold start)
#
# For a persistent production database, replace with a PostgreSQL async URL:
#   APP_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# and add `asyncpg` to requirements.txt.
# APP_DATABASE_URL=sqlite+aiosqlite:///./research_assistant.db


# ── Optional — Redis ──────────────────────────────────────────────────────────

# Redis is used for OTP storage and chat memory.
# Without it the app falls back to in-memory storage (fine for demos / single instance).
# For a managed Redis service on Vercel, try Upstash: https://upstash.com
# REDIS_HOST=localhost
# REDIS_PORT=6379


# ── Optional — CORS ───────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins.
# On Vercel you usually don't need this because the frontend and API share the
# same origin. Add your custom domain here if you're using one.
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com


# ── Optional — Auth ───────────────────────────────────────────────────────────

# Set to "true" in production (HTTPS only). Vercel always uses HTTPS.
# COOKIE_SECURE=true

# Set to "production" on Vercel.
# ENVIRONMENT=production
